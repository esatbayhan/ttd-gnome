#!/usr/bin/env bash
# Pre-commit hook: lint/test, local build check, then regenerate README screenshots.
#
# All steps must pass — the commit is blocked on failure.

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0

# ── CI checks (blocking) ──────────────────────────────────────────────

"$REPO_ROOT/devtools/ci.sh" || exit 1

# ── Local build check (blocking) ─────────────────────────────────────

echo "Checking local build..."
"$REPO_ROOT/dev-install.sh" || exit 1

# ── Screenshots (blocking) ────────────────────────────────────────────

cd "$REPO_ROOT"
python3 devtools/generate_readme_screenshots.py || exit 1
git add -- docs/screenshots/

exit 0
